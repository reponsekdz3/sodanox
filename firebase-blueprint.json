{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with social counts and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string" },
        "joinedDate": { "type": "string" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "followers": { "type": "array" },
        "following": { "type": "array" },
        "blockedUsers": { "type": "array" },
        "privateAccount": { "type": "boolean" },
        "showOnlineStatus": { "type": "boolean" },
        "allowReshare": { "type": "boolean" },
        "themePreference": { "type": "string" },
        "notificationPreferences": { "type": "object" },
        "mediaPreferences": { "type": "object" },
        "verified": { "type": "boolean" },
        "authProvider": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "username"]
    },
    "UserPrivateData": {
      "title": "UserPrivateData",
      "description": "Private sensitive settings, email, phone, blocked list, and notification preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "blockedUsers": { "type": "array" },
        "notificationPreferences": { "type": "object" },
        "mediaPreferences": { "type": "object" }
      }
    },
    "Post": {
      "title": "Post",
      "description": "Community posts with real likes, bookmarks, reposts, comments, and shares",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "author": { "type": "object" },
        "content": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "tags": { "type": "array" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "bookmarksCount": { "type": "number" },
        "bookmarkedBy": { "type": "array" },
        "repostsCount": { "type": "number" },
        "repostedBy": { "type": "array" },
        "sharesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "comments": { "type": "array" },
        "poll": { "type": "object" },
        "repostAuthor": { "type": "object" },
        "quotedPost": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "content"]
    },
    "Story": {
      "title": "Story",
      "description": "Real-time user stories with visual slides, mood tags, views, and replies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userUsername": { "type": "string" },
        "userAvatar": { "type": "string" },
        "items": { "type": "array" },
        "viewers": { "type": "array" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["userId", "items"]
    },
    "Reel": {
      "title": "Reel",
      "description": "Short-form video reel with real likes, bookmarks, comments, and shares",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "object" },
        "videoUrl": { "type": "string" },
        "posterUrl": { "type": "string" },
        "caption": { "type": "string" },
        "tags": { "type": "array" },
        "audioTrack": { "type": "object" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "bookmarksCount": { "type": "number" },
        "bookmarkedBy": { "type": "array" },
        "sharesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "comments": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["videoUrl", "caption"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time social interaction notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "actorId": { "type": "string" },
        "actor": { "type": "object" },
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "targetTitle": { "type": "string" },
        "text": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["recipientId", "type"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array" },
        "participants": { "type": "object" },
        "lastMessage": { "type": "object" },
        "updatedAt": { "type": "string" },
        "unreadCounts": { "type": "object" },
        "typing": { "type": "object" }
      },
      "required": ["participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message with text, voice note, photo, file, replyTo, reactions, and seen status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "file": { "type": "object" },
        "voice": { "type": "object" },
        "replyTo": { "type": "object" },
        "reaction": { "type": "string" },
        "status": { "type": "string" },
        "readAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["senderId", "type"]
    },
    "UserCredential": {
      "title": "UserCredential",
      "description": "Secure user auth registry document stored per email",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "salt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "passwordHash"]
    },
    "Call": {
      "title": "Call",
      "description": "Real-time audio and video call signaling document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "caller": { "type": "object" },
        "recipientId": { "type": "string" },
        "recipient": { "type": "object" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "endedAt": { "type": "string" }
      },
      "required": ["callerId", "recipientId", "type", "status"]
    },
    "Highlight": {
      "title": "Highlight",
      "description": "Curated story highlights for user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "coverUrl": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "coverUrl"]
    }
  },
  "firestore": {
    "/highlights/{highlightId}": {
      "schema": "Highlight",
      "description": "User profile story highlights collection"
    },
    "/calls/{callId}": {
      "schema": "Call",
      "description": "Real-time call sessions"
    },
    "/user_credentials/{email}": {
      "schema": "UserCredential",
      "description": "Secure authentication credentials registry"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateData",
      "description": "Private sensitive settings, email, phone, and blocklist"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Posts collection with social engagements"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Ephemeral user stories collection"
    },
    "/reels/{reelId}": {
      "schema": "Reel",
      "description": "Reels video feed collection"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications collection"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct messaging threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside conversation"
    }
  }
}

rules_version = '2';

/**
 * Aura Social - Hardened Zero-Trust Firestore Security Rules
 *
 * Security Invariants Enforced:
 * 1. Default Deny: All operations denied unless explicitly authorized.
 * 2. Strict Authentication: Unauthenticated requests (request.auth == null) are unconditionally rejected.
 * 3. Identity & Ownership: Write operations require authenticated UID match (authorId, userId, senderId).
 * 4. Privilege Escalation Prevention: Modifying role, isAdmin, or verified via client writes is blocked.
 * 5. PII & Sensitive Data Isolation: Private user settings (/users/{userId}/private/{docId}) restricted to owner only.
 * 6. Interaction Array Integrity: Likes, bookmarks, reposts, viewers, and votes can only add/remove the acting user's own UID.
 * 7. Conversation Secrecy: Direct messages and conversation threads restricted to explicit participants.
 * 8. Zero Client Access to Credentials: The /user_credentials collection is completely blocked from client reads/writes.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Core Helper Primitives
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthor(data) {
      return (data.get('authorId', '') == request.auth.uid) ||
             (data.author.id == request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'reponsekdz6@gmail.com' ||
        request.auth.token.email == 'reponsekdz01@gmail.com'
      );
    }

    // Global Catch-All: Denies any route not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 1. Users Collection (/users/{userId})
    // -------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated member can read public profile details
      allow read: if isSignedIn();

      // Only the profile owner can create their initial profile document
      allow create: if isOwner(userId) &&
        incoming().id == userId &&
        // Prevent new users from self-assigning admin or verified roles
        !incoming().keys().hasAny(['role', 'isAdmin']) &&
        incoming().get('verified', false) == false &&
        !incoming().keys().hasAny(['verifiedBadgeType', 'verifiedSince']);

      // Profile updates:
      // Either: Owner updates their profile (cannot modify role, verified, id, or email)
      // Profile updates:
      // Case 1: Super admin management
      // Case 2: Owner updates ordinary profile fields; verified status is server-controlled after gateway confirmation.
      // Case 3: Mutual social graph update (follow / unfollow by another user)
      allow update: if (
        isAdmin() ||
        (isOwner(userId) &&
         !incoming().diff(existing()).affectedKeys().hasAny(['id', 'createdAt', 'role', 'isAdmin', 'verified', 'verifiedBadgeType', 'verifiedSince'])) ||
        (isSignedIn() &&
         request.auth.uid != userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['followers', 'followersCount', 'updatedAt']) &&
         (
           (incoming().followers.hasAll(existing().followers) &&
            incoming().followers.removeAll(existing().followers).hasOnly([request.auth.uid]) &&
            incoming().followers.size() == existing().followers.size() + 1 &&
            incoming().followersCount == existing().followersCount + 1) ||
           (existing().followers.hasAll(incoming().followers) &&
            existing().followers.removeAll(incoming().followers).hasOnly([request.auth.uid]) &&
            incoming().followers.size() == existing().followers.size() - 1 &&
            incoming().followersCount == existing().followersCount - 1)
         )
        )
      );

      // Only owner can delete their account
      allow delete: if isOwner(userId);

      // Sensitive PII Subcollection: Email, phone, blocked users, private preferences
      // Strictly restricted: ONLY the owner can read or write
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------
    // 2. User Credentials Collection (/user_credentials/{credentialId})
    // -------------------------------------------------------------
    // Zero client access. Must only be handled server-side or via Firebase Auth
    match /user_credentials/{credentialId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 3. Posts Collection (/posts/{postId})
    // -------------------------------------------------------------
    match /posts/{postId} {
      allow read: if isSignedIn() && (
        resource.data.get('audience', 'public') == 'public' || isAuthor(resource.data)
      );
      allow create: if isSignedIn() &&
        (incoming().get('authorId', '') == request.auth.uid || incoming().author.id == request.auth.uid);

      // Authors may edit presentation/content fields only. Engagement metrics,
      // votes, and comments are maintained by validated transactions.
      allow update: if isSignedIn() && (
        (isAuthor(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
          'content', 'tags', 'location', 'audience', 'commentsDisabled', 'isEdited', 'updatedAt', 'filter', 'fontStyle'
        ])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount']) &&
          incoming().likesCount == incoming().likedBy.size() && (
            (incoming().likedBy.hasAll(existing().likedBy) &&
             incoming().likedBy.removeAll(existing().likedBy).hasOnly([request.auth.uid]) &&
             incoming().likedBy.size() == existing().likedBy.size() + 1) ||
            (existing().likedBy.hasAll(incoming().likedBy) &&
             existing().likedBy.removeAll(incoming().likedBy).hasOnly([request.auth.uid]) &&
             incoming().likedBy.size() == existing().likedBy.size() - 1)
          )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['bookmarkedBy', 'bookmarksCount']) &&
          incoming().bookmarksCount == incoming().bookmarkedBy.size() && (
            (incoming().bookmarkedBy.hasAll(existing().bookmarkedBy) &&
             incoming().bookmarkedBy.removeAll(existing().bookmarkedBy).hasOnly([request.auth.uid]) &&
             incoming().bookmarkedBy.size() == existing().bookmarkedBy.size() + 1) ||
            (existing().bookmarkedBy.hasAll(incoming().bookmarkedBy) &&
             existing().bookmarkedBy.removeAll(incoming().bookmarkedBy).hasOnly([request.auth.uid]) &&
             incoming().bookmarkedBy.size() == existing().bookmarkedBy.size() - 1)
          )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['repostedBy', 'repostsCount']) &&
          incoming().repostsCount == incoming().repostedBy.size() && (
            (incoming().repostedBy.hasAll(existing().repostedBy) &&
             incoming().repostedBy.removeAll(existing().repostedBy).hasOnly([request.auth.uid]) &&
             incoming().repostedBy.size() == existing().repostedBy.size() + 1) ||
            (existing().repostedBy.hasAll(incoming().repostedBy) &&
             existing().repostedBy.removeAll(incoming().repostedBy).hasOnly([request.auth.uid]) &&
             incoming().repostedBy.size() == existing().repostedBy.size() - 1)
          )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewedBy', 'viewsCount']) &&
          incoming().viewsCount == incoming().viewedBy.size() &&
          incoming().viewedBy.hasAll(existing().viewedBy) &&
          incoming().viewedBy.removeAll(existing().viewedBy).hasOnly([request.auth.uid]) &&
          incoming().viewedBy.size() == existing().viewedBy.size() + 1) ||

      );
      // Poll votes and comment mutations use authenticated Cloud Functions.
      allow delete: if isSignedIn() && isAuthor(existing());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------
    // 4. Stories Collection (/stories/{storyId})
    // -------------------------------------------------------------
    match /stories/{storyId} {
      allow read: if isSignedIn();

      // Only owner can create story with their own userId
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;

      // Update: Owner can manage items; others can only register their own view or submit poll/item interactions
      allow update: if isSignedIn() && (
        // Case A: Owner updates their story
        (existing().userId == request.auth.uid &&
         !incoming().diff(existing()).affectedKeys().hasAny(['id', 'userId', 'createdAt'])) ||

        // Case B: Viewer tracking (only adding own UID to viewers list)
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewers', 'viewersList']) && (
          incoming().viewers.hasAll(existing().viewers) &&
          incoming().viewers.removeAll(existing().viewers).hasOnly([request.auth.uid])
        ))
      );

      // Only story owner can delete story
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 5. Highlights Collection (/highlights/{highlightId})
    // -------------------------------------------------------------
    match /highlights/{highlightId} {
      // Authenticated users can read profile story highlights
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 6. Reels Collection (/reels/{reelId})
    // -------------------------------------------------------------
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (incoming().get('authorId', '') == request.auth.uid || incoming().author.id == request.auth.uid);
      allow update: if isSignedIn() && (
        (isAuthor(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([
          'caption', 'tags', 'audioTrack', 'isEdited', 'updatedAt'
        ])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount']) &&
          incoming().likesCount == incoming().likedBy.size() && (
            (incoming().likedBy.hasAll(existing().likedBy) &&
             incoming().likedBy.removeAll(existing().likedBy).hasOnly([request.auth.uid]) &&
             incoming().likedBy.size() == existing().likedBy.size() + 1) ||
            (existing().likedBy.hasAll(incoming().likedBy) &&
             existing().likedBy.removeAll(incoming().likedBy).hasOnly([request.auth.uid]) &&
             incoming().likedBy.size() == existing().likedBy.size() - 1)
          )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['bookmarkedBy', 'bookmarksCount']) &&
          incoming().bookmarksCount == incoming().bookmarkedBy.size() && (
            (incoming().bookmarkedBy.hasAll(existing().bookmarkedBy) &&
             incoming().bookmarkedBy.removeAll(existing().bookmarkedBy).hasOnly([request.auth.uid]) &&
             incoming().bookmarkedBy.size() == existing().bookmarkedBy.size() + 1) ||
            (existing().bookmarkedBy.hasAll(incoming().bookmarkedBy) &&
             existing().bookmarkedBy.removeAll(incoming().bookmarkedBy).hasOnly([request.auth.uid]) &&
             incoming().bookmarkedBy.size() == existing().bookmarkedBy.size() - 1)
          ))
      );
      // Comments and shares are recorded by authenticated Cloud Functions.
      allow delete: if isSignedIn() && isAuthor(existing());
    }

    // -------------------------------------------------------------
    // 7. Conversations & Messages (/conversations/{conversationId})
    // -------------------------------------------------------------
    match /conversations/{conversationId} {
      function otherParticipant(ids) {
        return ids[0] == request.auth.uid ? ids[1] : ids[0];
      }
      function participantsNotBlocked(ids) {
        let other = otherParticipant(ids);
        let selfPath = /databases/$(database)/documents/users/$(request.auth.uid)/private/settings;
        let otherPath = /databases/$(database)/documents/users/$(other)/private/settings;
        return isSignedIn() && ids is list && ids.size() == 2 && request.auth.uid in ids &&
          (!exists(selfPath) || !get(selfPath).data.get('blockedUsers', []).hasAny([other])) &&
          (!exists(otherPath) || !get(otherPath).data.get('blockedUsers', []).hasAny([request.auth.uid]));
      }
      function validConversationCreate() {
        return incoming().participantIds is list && incoming().participantIds.size() == 2 &&
          incoming().participantIds[0] != incoming().participantIds[1] &&
          request.auth.uid in incoming().participantIds &&
          incoming().lastMessage.senderId == request.auth.uid &&
          incoming().lastMessage.id is string;
      }
      function validTypingUpdate() {
        return incoming().diff(existing()).affectedKeys().hasOnly(['typing']) &&
          incoming().typing is map &&
          incoming().typing.diff(existing().typing).affectedKeys().hasOnly([request.auth.uid]) &&
          incoming().typing.get(request.auth.uid, false) is bool;
      }
      function validReadReceiptUpdate() {
        let ids = existing().participantIds;
        let other = otherParticipant(ids);
        return incoming().diff(existing()).affectedKeys().hasOnly(['unreadCounts']) &&
          incoming().unreadCounts.get(request.auth.uid, 0) == 0 &&
          incoming().unreadCounts.get(other, 0) == existing().unreadCounts.get(other, 0);
      }
      function validSendPreviewUpdate() {
        let ids = existing().participantIds;
        let other = otherParticipant(ids);
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(incoming().lastMessage.id);
        return incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'unreadCounts', 'updatedAt', 'typing']) &&
          incoming().lastMessage.senderId == request.auth.uid &&
          incoming().lastMessage.id is string &&
          incoming().unreadCounts.diff(existing().unreadCounts).affectedKeys().hasOnly([other]) &&
          incoming().unreadCounts.get(other, 0) == existing().unreadCounts.get(other, 0) + 1 &&
          incoming().unreadCounts.get(request.auth.uid, 0) == existing().unreadCounts.get(request.auth.uid, 0) &&
          incoming().typing.get(request.auth.uid, false) == false &&
          existsAfter(messagePath) && getAfter(messagePath).data.senderId == request.auth.uid &&
          getAfter(messagePath).data.conversationId == conversationId;
      }
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if participantsNotBlocked(incoming().participantIds) && validConversationCreate();
      // Participants may update only their own typing state, own unread receipt,
      // or a message preview that is tied to a real sender-authenticated message.
      allow update: if participantsNotBlocked(existing().participantIds) &&
        (validTypingUpdate() || validReadReceiptUpdate() || validSendPreviewUpdate());
      allow delete: if isSignedIn() && request.auth.uid in existing().participantIds;

      // Private, per-participant clear marker. This never deletes another member's history.
      match /userState/{userId} {
        function isConversationMember() {
          return isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
        allow read: if isConversationMember() && request.auth.uid == userId;
        allow create, update: if isConversationMember() && request.auth.uid == userId &&
          incoming().keys().hasOnly(['clearedAt', 'updatedAt']);
        allow delete: if isConversationMember() && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function parentParticipantsNotBlocked() {
          return participantsNotBlocked(parentConversation().participantIds);
        }
        allow read: if isSignedIn() && request.auth.uid in parentConversation().participantIds;
        allow create: if parentParticipantsNotBlocked() && incoming().senderId == request.auth.uid &&
          incoming().conversationId == conversationId && incoming().id == messageId &&
          incoming().createdAt != null;
        // Only safe reactions/read receipts can be changed by participants.
        allow update: if parentParticipantsNotBlocked() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['reaction', 'status', 'readAt']) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['status', 'readAt']) ||
            (existing().senderId != request.auth.uid && incoming().status == 'read'));
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid &&
          request.auth.uid in parentConversation().participantIds;
      }
    }
    // -------------------------------------------------------------
    // 8. Notifications Collection (/notifications/{notificationId})
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      // Only the recipient can read their notifications
      allow read: if isSignedIn() &&
        (resource.data.recipientId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid);

      // Any authenticated user can create a notification for another user, but actorId must equal auth UID
      allow create: if isSignedIn() &&
        (incoming().actorId == request.auth.uid ||
         incoming().get('senderId', '') == request.auth.uid ||
         incoming().actor.id == request.auth.uid);

      // Only recipient can mark as read or update their notification
      allow update: if isSignedIn() &&
        (resource.data.recipientId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid);

      // Only recipient can delete their notification
      allow delete: if isSignedIn() &&
        (resource.data.recipientId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid);
    }

    // -------------------------------------------------------------
    // 9. Calls Signaling Collection (/calls/{callId})
    // -------------------------------------------------------------
    match /calls/{callId} {
      function isCaller() { return isSignedIn() && existing().callerId == request.auth.uid; }
      function isRecipient() { return isSignedIn() && existing().recipientId == request.auth.uid; }
      function isCallParticipant() { return isCaller() || isRecipient(); }
      function changedCallKeys() { return incoming().diff(existing()).affectedKeys(); }
      function validCallEventFields() {
        return (!changedCallKeys().hasAny(['lastReaction']) ||
          (incoming().lastReaction.senderId == request.auth.uid && incoming().lastReaction.emoji in ['❤️', '👏', '🔥', '✨', '👋', '☕'])) &&
          (!changedCallKeys().hasAny(['lastQuickMessage']) ||
          (incoming().lastQuickMessage.senderId == request.auth.uid &&
           incoming().lastQuickMessage.text is string && incoming().lastQuickMessage.text.size() <= 500));
      }
      allow read: if isCallParticipant();
      allow create: if isSignedIn() && incoming().id == callId &&
        incoming().callerId == request.auth.uid && incoming().recipientId is string &&
        incoming().recipientId != request.auth.uid && incoming().type in ['audio', 'video'] &&
        incoming().status == 'ringing' &&
        incoming().keys().hasOnly(['id', 'callerId', 'caller', 'recipientId', 'recipient', 'type', 'status', 'createdAt']);
      // Caller publishes an offer/ends; recipient accepts, declines, ends, and publishes an answer.
      allow update: if isCallParticipant() && validCallEventFields() && (
        (isCaller() && changedCallKeys().hasOnly(['offer', 'lastReaction', 'lastQuickMessage', 'status', 'endedAt']) &&
          (!changedCallKeys().hasAny(['status']) || incoming().status == 'ended') &&
          (!changedCallKeys().hasAny(['endedAt']) || incoming().status == 'ended') &&
          (!changedCallKeys().hasAny(['offer']) || (incoming().offer.type == 'offer' &&
            incoming().offer.sdp is string && incoming().offer.sdp.size() <= 200000))) ||
        (isRecipient() && changedCallKeys().hasOnly(['answer', 'status', 'acceptedAt', 'connectedAt', 'endedAt', 'lastReaction', 'lastQuickMessage']) &&
          (!changedCallKeys().hasAny(['status']) || incoming().status in ['accepted', 'connected', 'declined', 'ended']) &&
          (!changedCallKeys().hasAny(['status']) || incoming().status != 'connected' || changedCallKeys().hasAny(['answer'])) &&
          (!changedCallKeys().hasAny(['endedAt']) || incoming().status in ['declined', 'ended']) &&
          (!changedCallKeys().hasAny(['answer']) || (incoming().status == 'connected' &&
            incoming().answer.type == 'answer' && incoming().answer.sdp is string && incoming().answer.sdp.size() <= 200000)))
      );
      allow delete: if isCallParticipant();
      match /callerCandidates/{candidateId} {
        function parentCall() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        function parentParticipant() { return isSignedIn() &&
          (parentCall().callerId == request.auth.uid || parentCall().recipientId == request.auth.uid); }
        allow read: if parentParticipant();
        allow create: if isSignedIn() && parentCall().callerId == request.auth.uid &&
          incoming().senderId == request.auth.uid && incoming().candidate is map;
        allow update: if false;
        allow delete: if isSignedIn() && parentCall().callerId == request.auth.uid && existing().senderId == request.auth.uid;
      }
      match /recipientCandidates/{candidateId} {
        function parentCall() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        function parentParticipant() { return isSignedIn() &&
          (parentCall().callerId == request.auth.uid || parentCall().recipientId == request.auth.uid); }
        allow read: if parentParticipant();
        allow create: if isSignedIn() && parentCall().recipientId == request.auth.uid &&
          incoming().senderId == request.auth.uid && incoming().candidate is map;
        allow update: if false;
        allow delete: if isSignedIn() && parentCall().recipientId == request.auth.uid && existing().senderId == request.auth.uid;
      }
      match /events/{eventId} {
        function parentCall() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        function parentParticipant() { return isSignedIn() &&
          (parentCall().callerId == request.auth.uid || parentCall().recipientId == request.auth.uid); }
        allow read: if parentParticipant();
        allow create: if parentParticipant() && incoming().senderId == request.auth.uid && (
          (incoming().kind == 'reaction' && incoming().emoji in ['❤️', '👏', '🔥', '✨', '👋', '☕']) ||
          (incoming().kind == 'message' && incoming().text is string && incoming().text.size() > 0 &&
            incoming().text.size() <= 500 && incoming().senderName is string && incoming().senderName.size() <= 80));
        allow update, delete: if false;
      }
    }
    // -------------------------------------------------------------
    // 10. Marketplace Items (/marketplace_items/{itemId})
    // -------------------------------------------------------------
    match /marketplace_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().seller.id == request.auth.uid &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120 &&
        incoming().price is number && incoming().price > 0 &&
        incoming().images is list && incoming().images.size() > 0 && incoming().images.size() <= 8 &&
        incoming().isSold == false;
      allow update: if isSignedIn() && resource.data.seller.id == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['id', 'seller', 'createdAt', 'viewsCount']) &&
        (!incoming().diff(existing()).affectedKeys().hasAny(['isSold']) || incoming().isSold == true);
      allow delete: if isSignedIn() && (resource.data.seller.id == request.auth.uid || isAdmin());
    }
    // -------------------------------------------------------------
    // 11. Sponsored Advertisements (/sponsored_ads/{adId})
    // -------------------------------------------------------------
    match /sponsored_ads/{adId} {
      allow read: if isSignedIn();
      // Client-submitted campaigns remain pending until an administrator approves them.
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid &&
        incoming().status == 'pending' && incoming().impressions == 0 && incoming().clicks == 0 &&
        incoming().budget is number && incoming().budget > 0 &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120;
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid && resource.data.status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'mediaUrl', 'mediaType', 'ctaText', 'ctaUrl', 'budget', 'targetCategory']));
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      // Delivery counters and event IDs are written only by the trusted callable.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // -------------------------------------------------------------
    // 12. Verification Payments Ledger (/verification_payments/{paymentId})
    // -------------------------------------------------------------
    match /verification_payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only trusted server code (Firebase Admin SDK) writes payment status and audit records.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 13. Test Collection (/test/{docId})
    // -------------------------------------------------------------
    // Completely locked down - no client reads or writes permitted
    match /test/{docId} {
      allow read, write: if false;
    }
  }
}

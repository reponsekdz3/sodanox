rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: Public profiles and member accounts
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Conversations collection: Direct and group messaging
    match /conversations/{conversationId} {
      allow read, create, update, delete: if true;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, create, update, delete: if true;
      }
    }

    // Posts collection: community feed, likes, bookmarks, reposts, comments, polls
    match /posts/{postId} {
      allow read, create, update, delete: if true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read, create, update, delete: if true;
      }
    }

    // Stories collection: creator stories, views, slides
    match /stories/{storyId} {
      allow read, create, update, delete: if true;
    }

    // Reels collection: short videos, interactions
    match /reels/{reelId} {
      allow read, create, update, delete: if true;
    }

    // Story Highlights collection
    match /highlights/{highlightId} {
      allow read, create, update, delete: if true;
    }

    // Notifications collection: alerts for likes, comments, reposts, follows
    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }
  }
}
